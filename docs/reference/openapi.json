    "/api/setup": {
      "get": {
        "summary": "Trmnl Setup",
        "description": "TRMNL bring-your-own-server handshake.\n\nTRMNL firmware calls this once with its MAC in the ``ID`` header and\nexpects an API key back. Maverick matches the MAC against a display's\n``transport.mac``, so a TRMNL panel needs no extra configuration.",
        "operationId": "trmnl_setup_api_setup_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
